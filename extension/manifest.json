{
  "manifest_version": 3,
  "name": "RadioTube Sender",
  "version": "1.0",
  "description": "Send the current YouTube video to your RadioTube room.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:5181/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtu.be/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["app-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send to RadioTube"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "radiotube-sender@radio2gether.com",
      "strict_min_version": "121.0"
    }
  }
}
